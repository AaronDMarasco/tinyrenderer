#!/bin/bash
clear
# Only do formatting/linting:
# LINT_ONLY=x
# Run the profiler:
# DO_PROFILE=x
# Skip some python self tests:
# export QUICK_CHECK=x
set -e
uv --preview-features format format --version "0.16.8"
set +e
uv run ssort --check --diff
uv run ruff check .
uv run mypy .
uv run pyrefly check --summarize-errors
if [[ -z ${LINT_ONLY} ]]; then
    if [[ -z ${DO_PROFILE} ]]; then
        uv run pytest -vv --cov --cov-report=html --cov-report=term-missing
        # --capture=tee-sys --durations=5
    else
        uv run python -m cProfile -o out.prof .venv/bin/pytest -vv
        # Comment out server part to have it launch browser too:
        uv run snakeviz out.prof --server
    fi
fi
